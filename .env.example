# ClassBridge 환경변수 템플릿. 실제 값은 이 파일에 쓰지 말고 .env(개발) 또는 Render 대시보드(운영)에 넣는다.

# development | test | production
APP_ENV=development
# 개발: sqlite:///./classbridge_dev.db  /  운영: Neon PostgreSQL pooled connection URI (sslmode=require)
DATABASE_URL=sqlite:///./classbridge_dev.db
# 운영 Neon: 마이그레이션/백업용 direct(비풀링) 연결 문자열. Git에 기입 금지.
# 값이 비어 있으면 DATABASE_URL을 사용한다 (개발/테스트 호환).
DATABASE_URL_DIRECT=
# 운영 필수: 32자 이상 임의 값  →  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret
# 외부에서 접속하는 주소 (OAuth 리디렉션 URI 계산에 사용)
BASE_URL=http://localhost:8000

# Google OAuth (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 최초 역할 부여 (쉼표 구분, 계정 최초 생성 시에만 적용)
ADMIN_EMAILS=admin@example.ac.kr
PROFESSOR_EMAILS=professor@example.ac.kr
# 비우면 모든 Google 계정 허용. 학교 도메인으로 제한 권장
ALLOWED_EMAIL_DOMAINS=

# 개발 전용 이메일 로그인. 운영에서 true면 서버가 시작을 거부한다
DEV_LOGIN_ENABLED=true

SESSION_TTL_HOURS=12
# 운영(HTTPS)에서는 반드시 true
COOKIE_SECURE=false

# 익명 기능: 운영 기본값은 false (개인정보·익명성 검토 후 true로)
FEATURE_SURVEYS=true
FEATURE_SUGGESTIONS=true

# disabled | demo(외부 전송 없는 로컬 분석) | external(외부 AI, 개인정보 검토 후)
AI_MODE=demo
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
